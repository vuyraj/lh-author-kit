{
  "manifest_version": 3,
  "name": "LH AuthorKit",
  "version": "1.0",
  "description": "Launch multiple tabs with URL replacements and group them by preset.",
  "icons": {
    "16": "icons/icon128-comp.png",
    "48": "icons/icon128-comp.png",
    "128": "icons/icon128-comp.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "tabGroups",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://author-airem-prod.lufthansa.com/*",
    "https://www.lufthansa.com/*",
    "https://www.swiss.com/*",
    "https://www.brusselsairlines.com/*",
    "https://www.austrian.com/*",
    "https://www.ita-airways.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LH AuthorKit"
  },
  "commands": {
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open extension popup"
    }
  }
}